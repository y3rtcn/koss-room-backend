# 제안용 로컬 설정. README의 source 명령으로 읽습니다. 실제 .env는 커밋하지 않습니다.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 기본 SQLite는 빠른 기능 확인용입니다. 동시성 검증/공유 환경은 PostgreSQL 사용.
DB_ENGINE=sqlite
PGDATABASE=koss_room
PGUSER=koss_room
PGPASSWORD=replace-with-your-local-password
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 배포 서버 설정 (로컬에서는 필요 없음) ---
# DJANGO_DEBUG를 지정하지 않으면 운영 모드(0)로 실행됩니다.
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))" 결과>
# DJANGO_ALLOWED_HOSTS=koss-room.example.com
# CSRF_TRUSTED_ORIGINS=https://koss-room.example.com
# WS_ALLOWED_ORIGINS=https://koss-room.example.com
# DB_ENGINE=postgresql
# Neon 등 연결 문자열 하나로 설정할 때(지정하면 PG* 값보다 우선). Render 절차: docs/deploy.md
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Render에서는 RENDER_EXTERNAL_HOSTNAME이 자동 설정되어 ALLOWED_HOSTS·WS_ALLOWED_ORIGINS에 추가됩니다.
# HTTPS 프록시 없이 직접 실행해 확인할 때만 0으로 바꿉니다.
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_HSTS_SECONDS=3600