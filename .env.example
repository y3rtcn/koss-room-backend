# A+B 데모 로컬 설정. README의 source 명령으로 읽습니다. 실제 .env는 커밋하지 않습니다.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 기본 SQLite는 빠른 기능 확인용입니다. 동시성 검증/공유 환경은 PostgreSQL 사용.
DB_ENGINE=sqlite
PGDATABASE=koss_room
PGUSER=koss_room
PGPASSWORD=replace-with-your-local-password
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer

# SQLite 파일을 별도로 사용하려면 지정 (기본: 저장소/db.sqlite3)
# SQLITE_PATH=/absolute/path/koss-room-demo.sqlite3
# seed_demo의 새 계정 비밀번호는 대화형 입력 또는 별도로 KOSS_DEMO_PASSWORD 주입
